{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan-loop state document",
  "description": "plan/<slug>.state.json, written only by scripts/plan_loop.py. The plan markdown is the source of node definitions and completion marks; this file adds the execution record. Validated by planlib/state.py, which supports only type, required, properties, additionalProperties, items, enum, const, pattern and minimum.",
  "type": "object",
  "required": ["schemaVersion", "kind", "generator", "updatedAt", "plan", "requirements", "scenarios", "nodes", "edges", "waves", "counts", "events"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "plan-loop.state"},
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"const": "plan_loop.py"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "updatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "plan": {
      "type": "object",
      "required": ["slug", "path", "title", "tier", "team", "status", "review", "sha256", "definitionDigest", "revision"],
      "additionalProperties": false,
      "properties": {
        "slug": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "path": {"type": "string", "pattern": "^plan/[^/\\\\]+\\.md$"},
        "title": {"type": "string"},
        "tier": {"enum": ["team", "workflow"]},
        "team": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "review": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "definitionDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "done"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}$"},
          "text": {"type": "string"},
          "done": {"type": "boolean"}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "requirements", "executor", "status", "candidate", "evidence", "recordedAt"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^AT-[0-9]{2,3}$"},
          "title": {"type": "string"},
          "requirements": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}$"}},
          "executor": {"type": ["string", "null"]},
          "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"]},
          "candidate": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]},
          "recordedAt": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "title", "kind", "owner", "ownerKind", "after", "writes", "scenarios", "wave", "digest", "stale",
          "state", "attempt", "startedAt", "finishedAt", "executor", "confirmedBy", "lastError", "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}[a-z]?$"},
          "title": {"type": "string"},
          "kind": {"enum": ["work", "gate-test", "gate-review"]},
          "owner": {"type": ["string", "null"]},
          "ownerKind": {"enum": ["orchestrator", "writer", "executor", "reviewer", null]},
          "after": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}[a-z]?$"}},
          "writes": {"type": "array", "items": {"type": "string"}},
          "scenarios": {"type": "array", "items": {"type": "string", "pattern": "^AT-[0-9]{2,3}$"}},
          "wave": {"type": ["integer", "null"], "minimum": 1},
          "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stale": {"type": "boolean"},
          "state": {"enum": ["pending", "running", "claimed", "done", "blocked"]},
          "attempt": {"type": "integer", "minimum": 0},
          "startedAt": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "finishedAt": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "executor": {
            "type": "object",
            "required": ["agent", "provider", "model", "effort"],
            "additionalProperties": false,
            "properties": {
              "agent": {"type": ["string", "null"]},
              "provider": {"type": ["string", "null"]},
              "model": {"type": ["string", "null"]},
              "effort": {"type": ["string", "null"]}
            }
          },
          "confirmedBy": {"type": ["string", "null"]},
          "lastError": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}[a-z]?$"},
          "to": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}[a-z]?$"}
        }
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "name", "nodes", "state"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "nodes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,3}[a-z]?$"}},
          "state": {"enum": ["pending", "active", "closed"]}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["pending", "running", "claimed", "done", "blocked"],
      "additionalProperties": false,
      "properties": {
        "pending": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "claimed": {"type": "integer", "minimum": 0},
        "done": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0}
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "at", "type", "node", "scenario", "by", "data"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "type": {
            "enum": [
              "synced", "reconciled", "plan.status", "node.started", "node.claimed", "node.done",
              "node.failed", "node.blocked", "node.reset", "scenario.recorded"
            ]
          },
          "node": {"type": ["string", "null"], "pattern": "^[A-Z]{1,3}[0-9]{1,3}[a-z]?$"},
          "scenario": {"type": ["string", "null"], "pattern": "^AT-[0-9]{2,3}$"},
          "by": {"type": "string"},
          "data": {"type": "object"}
        }
      }
    }
  }
}
